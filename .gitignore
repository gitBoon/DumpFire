# Backup/restore temp files
.pre-restore-safety.json
.restore-temp.*
# A backup's two copies, left beside the database by a crash (backup.ts:
# <db>.backup-temp and <db>.backup-temp-cleared, with any -journal, -wal or
# -shm beside either). The first holds live sessions. Anywhere in the tree.
*.backup-temp
*.backup-temp-*

# Debug/log files
check-errors.txt
warn_machine.txt
warnings*.txt

# User uploads (card attachments)
uploads/

# IDE / editor config
.vscode/

# Agent workflows (local only)
.agent/

# Claude Code settings, agents and skills (local only)
.claude/

# Card planning documents (local only; synced to the shared drive and Merview)
docs/planning/

# A test reporter's output (vitest --outputFile), never committed
.vitest/
