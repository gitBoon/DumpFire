{
	"name": "dumpfire",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "node scripts/generate-expected-schema.mjs --check && npm run check",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "vitest run --allowOnly=false",
		"rehearse": "node scripts/rehearse.mjs",
		"schema:expected": "node scripts/generate-expected-schema.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bcryptjs": "^2.4.6",
		"@types/better-sqlite3": "^7.6.13",
		"@types/d3-force": "^3.0.10",
		"@types/dompurify": "^3.0.5",
		"@types/jsdom": "^28.0.3",
		"@types/ssh2-sftp-client": "^9.0.6",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^29.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.4.8",
		"typescript": "^5.9.3",
		"vite": "^8.0.13",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1047.0",
		"@azure/identity": "^4.13.1",
		"@microsoft/microsoft-graph-client": "^3.0.7",
		"@types/pdfkit": "^0.17.6",
		"bcryptjs": "^3.0.3",
		"better-sqlite3": "^12.10.0",
		"d3-force": "^3.0.0",
		"dompurify": "^3.4.17",
		"drizzle-orm": "^0.45.2",
		"googleapis": "^171.4.0",
		"marked": "^18.0.3",
		"nodemailer": "10.1.1",
		"pdfkit": "^0.18.0",
		"ssh2-sftp-client": "^12.1.1",
		"svelte-dnd-action": "^0.9.69"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.0"
		},
		"qs": "6.16.0"
	}
}
